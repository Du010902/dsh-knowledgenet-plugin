{
  "name": "@local/dsh-knowledgenet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把本地 KnowledgeNet 知识库（v2 开放文件格式）接进 DSH：知识点与前置依赖工具，加上会话内的图谱卡片",
  "license": "MIT",
  "meta": {
    "title": "KnowledgeNet",
    "description": "在会话里学习本地知识库的节点与前置依赖"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "package.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "sync": "node scripts/sync-vendor.mjs",
    "sync:check": "node scripts/sync-vendor.mjs --check",
    "build": "node build.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@milkdown/crepe": "7.22.2",
    "@milkdown/kit": "7.22.2",
    "d3-force-3d": "3.0.6",
    "katex": "0.18.9",
    "three": "0.186.0"
  }
}
